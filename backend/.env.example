PORT=8000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority&appName=Automation-Script
MONGODB_DB_NAME=testhive
MONGODB_APP_NAME=Automation-Script

# Optional connection tuning (Atlas M0 friendly defaults are used when omitted)
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# QuickFlow defaults (optional; can be supplied via API payloads)
QT_URL=https://ipdev.quickflow.in/login
QT_USER=
QT_PASS=
QT_USER2=
QT_PASS2=

# Error Handling (EH) suite specific overrides
# Leave blank to fall back to QT_USER/QT_PASS where supported.
QT_EH_ENTRY_USER=
QT_EH_ENTRY_PASS=
QT_EH_ADMIN_USER=
QT_EH_ADMIN_PASS=
QT_EH_SUPERVISOR_USER=
QT_EH_SUPERVISOR_PASS=
QT_EH_REVIEWER_USER=

# EH module routes/paths (route path like /Country or master slug like Country)
QT_EH_FORM_ISSUANCE_PATH=/Form-Issuance
QT_EH_COUNTRY_PATH=/Country
QT_EH_UPLOAD_PATH=/Form-Issuance
QT_EH_LOGS_PATH=/Logs
QT_EH_USER_ADMIN_PATH=/User
QT_EH_WORKFLOW_MONITOR_PATH=/Form-Issuance
QT_EH_NON_EXISTENT_PATH=/nonexistent-page
